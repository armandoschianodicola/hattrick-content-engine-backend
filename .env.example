ENVIRONMENT=development
API_PORT=8020
DATABASE_URL=postgresql+asyncpg://hattrick:hattrick@localhost:5434/hattrick
POSTGRES_PASSWORD=hattrick
API_KEY=local-development-key-change-me
RETRIEVAL_PROVIDER=fake
AI_PROVIDER=fake
ALLOW_ILLUSTRATIVE_EVIDENCE=true
# Switch AI_PROVIDER=openai to generate with OpenAI. Never commit credentials.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Omit temperature for models that do not support it.
# OPENAI_TEMPERATURE=0.3
OPENAI_MAX_OUTPUT_TOKENS=2500
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RETRIEVAL_LIMIT=8
RETRIEVAL_MIN_SIMILARITY=0.25
ASSETS_DIRECTORY=data/assets
# FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
HTTP_TIMEOUT_SECONDS=30
